set_false_path -hold -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video_mmio/(pa_meta|cp_meta).*}]
set_max_delay -datapath_only 8.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {run_meta.*}]
set_false_path -hold -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {run_meta.*}]
set_max_delay -datapath_only 8.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {(dv_meta|mode_meta).*}]
set_false_path -hold -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {(dv_meta|mode_meta).*}]
set_max_delay -datapath_only 15.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video_mmio/cam_snapshot.*}]
set_false_path -hold -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video_mmio/cam_snapshot.*}]
set_max_delay -datapath_only 15.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video_mmio/pix_snapshot.*}]
set_false_path -hold -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video_mmio/pix_snapshot.*}]
set_false_path -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_cam_snapshot/reset_pipe.*}]
set_false_path -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_pix_snapshot/reset_pipe.*}]
set_false_path -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_video/(cam_reset_pipe|pix_reset_pipe).*}]

