create_generated_clock -name cpu_clk -source [get_ports free_clk] -multiply_by 100 -divide_by 27 [get_pins u_clock/u_pll/CLKOUT0]
set_clock_uncertainty -setup 0.500 [get_clocks cpu_clk]
set_clock_uncertainty -hold 0.200 [get_clocks cpu_clk]

###==== BEGIN R2 mailbox/CDC candidate (research candidate v2, NOT sign-off)
### Written against mapped names from the first research build.
### Every pattern below must be validated by a hit count and an empty-match negative control.
# 1) request bundle: CPU(sclk) -> DDR(dclk), 69 bits (addr32 + wdata32 + wstrb4 + write1)
set_max_delay 16.0 -datapath_only -from [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/request_payload*}] -to [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/d_req_addr* u_soc/u_ddr_path/mailbox/d_req_wdata* u_soc/u_ddr_path/mailbox/d_req_wstrb* u_soc/u_ddr_path/mailbox/d_req_write*}]
# 2) request event: only the first synchroniser stage may be cut; stage1 -> stage2 stays timed
set_false_path -from [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/request_toggle}] -to [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/req_sync*}]
# 3) response bundle: DDR(dclk) -> CPU(sclk), 34 bits (data32 + error1 + accepted1)
set_max_delay 20.0 -datapath_only -from [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/response_payload*}] -to [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/rsp_data* u_soc/u_ddr_path/mailbox/rsp_error* u_soc/u_ddr_path/mailbox/write_accepted*}]
# 4) response event
set_false_path -from [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/ack_toggle}] -to [get_cells -hierarchical {u_soc/u_ddr_path/mailbox/ack_sync*}]
# 5) DDR init done: vendor DFI output (ddrphy_sysclk) -> CPU-domain reset gate
set_false_path -from [get_cells -hierarchical {I_ips_ddr_top/u_ddrphy_top/ddrphy_dfi/dfi_init_complete*}] -to [get_cells -hierarchical {u_reset_gate/init_sync*}]
# 6) active (combinational in dclk) -> avail_sync, sources limited to the dclk-domain producers
set_max_delay 8.0 -datapath_only -from [get_cells -hierarchical {u_soc/u_ddr_path/drst* u_soc/u_ddr_path/seen* u_soc/u_ddr_path/quarantine* u_soc/u_ddr_path/bridge/fault* I_ips_ddr_top/u_ddrphy_top/ddrphy_dfi/dfi_init_complete*}] -to [get_cells -hierarchical {u_soc/u_ddr_path/avail_sync*}]
# 7) quarantine|fault -> fault_sync, same limitation
set_max_delay 8.0 -datapath_only -from [get_cells -hierarchical {u_soc/u_ddr_path/seen* u_soc/u_ddr_path/quarantine* u_soc/u_ddr_path/bridge/fault*}] -to [get_cells -hierarchical {u_soc/u_ddr_path/fault_sync*}]
###==== END R2 mailbox/CDC candidate

###==== VIDEO CONSTRAINTS MERGED FROM D3 PACKAGE (2026-10-29) ====
