create_generated_clock -name pix_clk -source [get_ports free_clk] -multiply_by 11 -divide_by 8 [get_pins u_video_clock/u_pix_pll/CLKOUT0]
set_clock_uncertainty -setup 0.500 [get_clocks pix_clk]
set_clock_uncertainty -hold 0.200 [get_clocks pix_clk]
create_clock -name cam_pclk -period 10.416667 [get_ports cam_pclk]
set_clock_uncertainty -setup 0.500 [get_clocks cam_pclk]
set_clock_uncertainty -hold 0.200 [get_clocks cam_pclk]
set_max_delay -datapath_only 8.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/wgray_r1.*}]
set_max_skew 8.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/wgray_r1.*}]
set_false_path -hold -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/wgray_r1.*}]
set_max_delay -datapath_only 8.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/rgray_w1.*}]
set_max_skew 8.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/rgray_w1.*}]
set_false_path -hold -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/ready_fifo/rgray_w1.*}]
set_max_delay -datapath_only 15.000 -from [get_cells -hierarchical -regexp {u_video/ready_fifo/mem.*}] -to [get_clocks pix_clk]
set_false_path -hold -from [get_cells -hierarchical -regexp {u_video/ready_fifo/mem.*}] -to [get_clocks pix_clk]
set_max_delay -datapath_only 8.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/wgray_r1.*}]
set_max_skew 8.000 -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/wgray_r1.*}]
set_false_path -hold -from [get_clocks pix_clk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/wgray_r1.*}]
set_max_delay -datapath_only 8.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/rgray_w1.*}]
set_max_skew 8.000 -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/rgray_w1.*}]
set_false_path -hold -from [get_clocks cam_pclk] -to [get_cells -hierarchical -regexp {u_video/return_fifo/rgray_w1.*}]
set_max_delay -datapath_only 15.000 -from [get_cells -hierarchical -regexp {u_video/return_fifo/mem.*}] -to [get_clocks cam_pclk]
set_false_path -hold -from [get_cells -hierarchical -regexp {u_video/return_fifo/mem.*}] -to [get_clocks cam_pclk]
set_max_delay -datapath_only 8.000 -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_video/(cam_en_sync|cam_freeze_sync|cam_clear_sync).*}]
set_false_path -hold -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_video/(cam_en_sync|cam_freeze_sync|cam_clear_sync).*}]
set_max_delay -datapath_only 8.000 -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_video/(pix_en_sync|pix_freeze_sync|pix_clear_sync|pat_sync).*}]
set_false_path -hold -from [get_clocks cpu_clk] -to [get_cells -hierarchical -regexp {u_video/(pix_en_sync|pix_freeze_sync|pix_clear_sync|pat_sync).*}]
